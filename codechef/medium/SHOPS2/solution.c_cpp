#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, d;
    cin >> n >> d;
    vector<long long> a(n), b(n);
    long long sumA = 0, sumB = 0;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sumA += a[i];
    }
    for (int i = 0; i < n; i++) {
        cin >> b[i];
        sumB += b[i];
    }

    long long ans = d + sumA;

    ans = min(ans, (long long)d + sumB);

    // Option 3: Visit both shops
    long long bothCost = 2LL * d;
    for (int i = 0; i < n; i++) {
        bothCost += min(a[i], b[i]);
    }
    ans = min(ans, bothCost);

    cout << ans << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
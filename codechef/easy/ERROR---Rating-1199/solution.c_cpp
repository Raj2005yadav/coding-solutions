#include <iostream>
#include <string>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        bool isGood = false;
        int n = (int)s.size();

        for (int i = 0; i + 2 < n; i++) {
            if ((s[i] == '0' && s[i + 1] == '1' && s[i + 2] == '0') ||
                (s[i] == '1' && s[i + 1] == '0' && s[i + 2] == '1')) {
                isGood = true;
                break;
            }
        }

        if (isGood) {
            cout << "Good\n";
        } else {
            cout << "Bad\n";
        }
    }

    return 0;
}
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        string s,r;
        cin>>s>>r;
        // your code goes here
        int changes = 0;
        for (int i = 0; i < n; i++) {
            if (s[i] != r[i]) {
                changes++;
            }
        }
        
        // Initial state is on (1). 
        // If changes is odd, state flips to 0. If even, remains 1.
        if (changes % 2 != 0) {
            cout << 0 << "\n";
        } else {
            cout << 1 << "\n";
        }
    }
    return 0;

}


#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        string s;
        cin >> s;

        bool valid = true;

        for (int i = 0; i < s.size(); i += 2) {
            if (!((s[i] == 'A' && s[i+1] == 'B') ||
                  (s[i] == 'B' && s[i+1] == 'A'))) {
                valid = false;
                break;
            }
        }

        if (valid)
            cout << "yes" << endl;
        else
            cout << "no" << endl;
    }

    return 0;
}

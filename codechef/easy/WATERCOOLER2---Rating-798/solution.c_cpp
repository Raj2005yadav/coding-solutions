#include <bits/stdc++.h>
using namespace std;

int main() {
    
    int t;
    cin >> t;
    while (t--) {
        long long x, y;
        cin >> x >> y;

        long long months = y / x;
        if (y % x == 0) {
            months -= 1;
        }

        if (months < 0) {
            months = 0;
        }

        cout << months << "\n";
    }

    return 0;
}
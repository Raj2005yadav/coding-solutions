#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        long long sum = 0;
        int mn = 10001;

        for (int i = 0; i < N; i++) {
            int x;
            cin >> x;

            sum += x;

            if (x < mn) {
                mn = x;
            }
        }

        cout << sum - mn << endl;
    }

    return 0;
}
